rules_version = '2';

// SMETracker - Firebase Storage Rules
//
// Business-scoped via cross-service firestore.get() on phoneIndex, mirroring
// firestore.rules' isMemberOf/isOwnerOf pattern (Blaze-only capability -
// previously stubbed to signed-in-only while on Spark; see git history).
//
// Path segments below are dictated by the actual upload call sites, not the
// other way around - keep these in sync with:
//   - InventorySync.pushPending: businesses/{businessId}/inventory/{itemId}.jpg
//   - ExpenseSync.pushPending:   businesses/{businessId}/expense_receipts/{expenseId}.jpg

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null && request.auth.token.phone_number != null;
    }

    function myPhone() {
      return request.auth.token.phone_number;
    }

    // Firestore's default database - matches firestore.rules' $(database)
    // being called with the (default) database in this project.
    function phoneIndexData() {
      return firestore.get(/databases/(default)/documents/phoneIndex/$(myPhone())).data;
    }

    function isMemberOf(businessId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/phoneIndex/$(myPhone()))
        && phoneIndexData().businessId == businessId;
    }

    function isOwnerOf(businessId) {
      return isMemberOf(businessId) && phoneIndexData().role == 'OWNER';
    }

    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Path matches InventorySync.pushPending exactly: {item.id}.jpg, not a
    // generic {imageId} - kept as a named capture for readability, but any
    // itemId under a business the requester belongs to is fair game since
    // isMemberOf(businessId) already scopes it.
    //
    // Members can still add and replace photos: firestore.rules lets any member
    // update any item, and the app uploads the photo BEFORE the item doc exists,
    // so tying a replacement to the item's creator would leave a worker's edit of
    // an owner-created item stuck retrying. Deletes are owner-only, matching the
    // inventory delete rule in firestore.rules (the app itself never deletes
    // Storage files).
    match /businesses/{businessId}/inventory/{itemId} {
      allow read: if isMemberOf(businessId);
      allow create, update: if isMemberOf(businessId) && isValidImage();
      allow delete: if isOwnerOf(businessId);
    }

    // Expenses are read-restricted in Firestore (workers see only their own),
    // so this mirrors that exactly via a firestore.get() on the receipt's
    // owning expense doc. That lookup only runs for the worker branch below -
    // rules evaluate `||` with short-circuit, so an owner's read never pays
    // for it, and a worker's is one extra doc read per receipt view.
    //
    // The doc is guaranteed to exist by the time this rule runs: the upload
    // in ExpenseSync.pushPending finishes before the Firestore expense write
    // (see that function), and receiptUrl only reaches Room - and therefore
    // only gets requested by AsyncImage - once the corresponding expense doc
    // has synced down with its recordedBy field already set. Soft deletes
    // (isDeleted) don't remove the doc either, so this holds even for a
    // deleted expense's receipt.
    match /businesses/{businessId}/expense_receipts/{expenseId} {
      // expenseId here is the full storage object name, e.g.
      // "abc123.jpg" - ExpenseSync.pushPending always appends ".jpg", so
      // stripping the last 4 characters recovers the actual Firestore
      // expense document ID.
      function expenseRecordedBy() {
        let docId = expenseId[0:expenseId.size() - 4];
        return firestore.get(
          /databases/(default)/documents/businesses/$(businessId)/expenses/$(docId)
        ).data.recordedBy;
      }

      allow read: if isOwnerOf(businessId)
        || (isMemberOf(businessId) && expenseRecordedBy() == myPhone());

      // Writes mirror the Firestore expense rules (a worker only ever touches
      // their own expenses): an owner may write any receipt; a member may write
      // one only if its expense doc does not exist yet or was recorded by them.
      //
      // "Does not exist yet" is the first-upload case: ExpenseSync.pushPending
      // uploads the receipt BEFORE writing the expense doc, so there is no
      // recordedBy to check yet, and the doc write immediately after is what
      // establishes ownership (Firestore's create rule requires recordedBy to equal
      // the uploader's phone). Expense ids are random and unguessable, so nobody
      // can pre-claim another member's future receipt path. Once the doc exists,
      // only its recorder (or an owner) can overwrite the receipt, so one worker
      // can no longer replace another worker's proof of expense.
      function receiptDocPath() {
        let docId = expenseId[0:expenseId.size() - 4];
        return /databases/(default)/documents/businesses/$(businessId)/expenses/$(docId);
      }

      function canWriteReceipt() {
        return isOwnerOf(businessId)
          || (isMemberOf(businessId)
              && (!firestore.exists(receiptDocPath())
                  || firestore.get(receiptDocPath()).data.recordedBy == myPhone()));
      }

      allow create, update: if isValidImage() && canWriteReceipt();

      allow delete: if isOwnerOf(businessId);
    }
  }
}