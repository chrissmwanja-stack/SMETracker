<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
    Session state (phone number, business_id, active role) lives in this
    DataStore file. Excluded because a restore onto a new/reset device would
    make the app believe it's logged in as a business/role without Firebase
    Auth actually having a matching live session - the two would go out of
    sync silently. See SessionManager.kt for what's stored here.
    -->
    <exclude domain="datastore" path="sme_session.preferences_pb"/>
</full-backup-content>