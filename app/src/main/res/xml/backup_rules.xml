<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
    Session state (phone number, business_id, active role) lives in this
    DataStore file. Excluded because a restore onto a new/reset device would
    make the app believe it's logged in as a business/role without Firebase
    Auth actually having a matching live session - the two would go out of
    sync silently. See SessionManager.kt for what's stored here.
    -->
    <exclude domain="file" path="datastore/sme_session.preferences_pb"/>
    <!--
    The Room database holds local_credentials (PIN hash + salt) plus cached
    business data. It is excluded so the PIN hash never leaves the device via
    Google backup or device transfer, where it could be attacked offline. After a
    restore the user signs in with OTP and Firestore sync repopulates the data.
    Room's -wal/-shm/-journal sidecar files are excluded too.
    -->
    <exclude domain="database" path="sme_tracker_database"/>
    <exclude domain="database" path="sme_tracker_database-wal"/>
    <exclude domain="database" path="sme_tracker_database-shm"/>
    <exclude domain="database" path="sme_tracker_database-journal"/>
</full-backup-content>