<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
        Session state (phone number, business_id, active role) - excluded so
        a restore can't leave the app believing it's logged in without a
        matching live Firebase Auth session. See SessionManager.kt.
        -->
        <exclude domain="file" path="datastore/sme_session.preferences_pb"/>
        <!--
        The Room database holds local_credentials (PIN hash + salt) plus cached
        business data. It is excluded so the PIN hash never leaves the device via
        Google backup or device transfer, where it could be attacked offline. After a
        restore the user signs in with OTP and Firestore sync repopulates the data.
        Room's -wal/-shm/-journal sidecar files are excluded too.
        -->
        <exclude domain="database" path="sme_tracker_database"/>
        <exclude domain="database" path="sme_tracker_database-wal"/>
        <exclude domain="database" path="sme_tracker_database-shm"/>
        <exclude domain="database" path="sme_tracker_database-journal"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sme_session.preferences_pb"/>
        <!--
        The Room database holds local_credentials (PIN hash + salt) plus cached
        business data. It is excluded so the PIN hash never leaves the device via
        Google backup or device transfer, where it could be attacked offline. After a
        restore the user signs in with OTP and Firestore sync repopulates the data.
        Room's -wal/-shm/-journal sidecar files are excluded too.
        -->
        <exclude domain="database" path="sme_tracker_database"/>
        <exclude domain="database" path="sme_tracker_database-wal"/>
        <exclude domain="database" path="sme_tracker_database-shm"/>
        <exclude domain="database" path="sme_tracker_database-journal"/>
    </device-transfer>
</data-extraction-rules>