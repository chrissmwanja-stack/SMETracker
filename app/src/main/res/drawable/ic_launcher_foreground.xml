<?xml version="1.0" encoding="utf-8"?>
<!--
    SMETracker adaptive icon - foreground layer.
    Ledger + checkmark: a notebook (teal spiral binding) with a teal
    checkmark badge, reading as "bookkeeping, done right."
    All artwork is kept inside the ~66dp "safe zone" centered on the
    108x108dp canvas, since launchers mask this layer to a circle,
    squircle, or rounded square and anything outside that zone can be
    clipped. Pairs with ic_launcher_background.xml (navy) beneath it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Notebook page -->
    <path
        android:fillColor="#F5F7FA"
        android:pathData="M36,28h36a6,6 0,0 1,6 6v36a6,6 0,0 1,-6 6h-36a6,6 0,0 1,-6 -6v-36a6,6 0,0 1,6 -6z" />

    <!-- Spiral binding -->
    <path
        android:fillColor="#1D9E75"
        android:pathData="M30,28h7a6,6 0,0 1,6 6v36a6,6 0,0 1,-6 6h-7a6,6 0,0 1,-6 -6v-36a6,6 0,0 1,6 -6z" />

    <!-- Text lines on the page -->
    <path
        android:fillColor="#00000000"
        android:pathData="M40,40h26"
        android:strokeColor="#102C57"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#00000000"
        android:pathData="M40,50h26"
        android:strokeColor="#102C57"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#00000000"
        android:pathData="M40,60h18"
        android:strokeColor="#102C57"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />

    <!-- Checkmark badge -->
    <path
        android:fillColor="#1D9E75"
        android:strokeColor="#F5F7FA"
        android:strokeWidth="2"
        android:pathData="M79,69m-10,0a10,10 0,1 1,20 0a10,10 0,1 1,-20 0" />
    <path
        android:fillColor="#00000000"
        android:pathData="M73,69l4,4l9,-11"
        android:strokeColor="#F5F7FA"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
