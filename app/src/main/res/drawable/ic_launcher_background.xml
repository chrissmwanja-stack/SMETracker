<?xml version="1.0" encoding="utf-8"?>
<!--
    SMETracker adaptive icon - background layer.
    Solid brand navy (#102C57), matching Vestateck's site palette so
    SMETracker reads as part of the same product family as ClubVest.
    Adaptive icons need the background to fully cover the 108x108dp canvas;
    masking (circle/squircle/rounded square) is applied by the launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#102C57"
        android:pathData="M0,0h108v108h-108z" />
</vector>
