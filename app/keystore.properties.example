# Copy this file to app/keystore.properties and fill in your real values.
# app/keystore.properties itself is gitignored - never commit your real
# keystore or its passwords.
#
# Generate the keystore once (keep it forever - Play Store uploads require
# the same upload key for the life of the app):
#   keytool -genkeypair -v -keystore smetracker-upload.jks \
#     -alias smetracker -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is relative to the app/ module directory.
storeFile=../smetracker-upload.jks
storePassword=CHANGE_ME
keyAlias=smetracker
keyPassword=CHANGE_ME